{
  "registry": "CARBON_ACTUAL_GLOBAL_API_FEDERATION",
  "version": "2026-09-19",
  "status": "curated-and-discovery-ready",
  "purpose": "Global public API and machine-readable data-source federation for Carbon Actual. It covers Earth, Solar-System, frontier and unknown horizons without treating any provider as constitutional authority.",
  "nonredundancy_rule": "one canonical capability -> many provider adapters -> one governed evidence/result path",
  "deployment_gate": "catalog_and_capability_registry_ready; credentials_externalized; adapters_verified_before_production",
  "universe_scope": [
    "Nigeria",
    "Africa",
    "Earth",
    "Near-Earth",
    "Solar-System",
    "Beyond-Earth",
    "Unknown-Alien"
  ],
  "reality_horizon": [
