  "composite_boundaries": {
    "rites": {
      "specialized_national_authority": false,
      "method": "compose function-specific authorities",
      "authority_chain": ["ng:nimc","ng:npc","ng:ndpc","jurisdiction_specific_probate_registry","relevant_health_or_religious_institution"],
      "notes": "RITES is a Carbon Actual continuity product, not a Nigerian government authority. Use the competent institution for each transition instead of inventing a single RITES authority."
    },
    "cultural_atlas": {
      "specialized_national_knowledge_authority": false,
      "method": "combine cultural, heritage, library and rights-bearing sources",
      "authority_chain": ["ng:nico","ng:ncmm","ng:nln","community_or_custodian_source","international_reference_where_applicable"],
      "notes": "The Cultural Atlas is a curated representation. A source can establish evidence/provenance without becoming universal authority."
    },
    "omni_tip_trade_and_investment": {
      "specialized_universal_market_authority": false,
      "method": "compose regulator + market + provider sources",
      "authority_chain": ["ng:sec","ng:cbn","ng:ngx","ng:nasd","ng:ncs","ng:nrs"],
      "notes": "OMNI/TIP should route to the competent regulator or market operator per transaction type and jurisdiction."
    }
  }
}
