{
  "registry": "CARBON_ACTUAL_EXTERNAL_INSTITUTION_AUTHORITY",
  "version": "2026-09-19",
  "status": "curated",
  "purpose": "Map external institutions and authoritative public sources to scoped capabilities without promoting any external institution into Carbon Actual constitutional authority.",
  "governing_principle": "External authority is scoped to the institution's lawful or operational remit. Carbon Actual/ABBA may discover, contextualize, route and record; it does not infer institutional authority from a name, API, match or data source.",
  "source_rule": "Prefer current first-party institutional sources. When no single specialized institution exists for a domain, compose the relevant public authorities and explicitly label the boundary rather than inventing a specialized institution.",
  "reviewed_on": "2026-09-19",
  "institutions": [
    {
      "key": "ng:nimc",
      "name": "National Identity Management Commission",
      "jurisdiction": "Nigeria",
      "domains": ["identity","digital_identity","authentication","interoperability","electronic_trust"],
      "authority_scope": ["national_identity","NIN","national_PKI_root","digital_public_infrastructure_trust"],
      "capabilities": ["identity_verification","credential_trust","authoritative_identity_reference","interoperability_reference"],
      "source": "https://nimc.gov.ng/press-releases/president-tinubu-signs-nimc-act-2026-into-law",
      "source_type": "official",
      "freshness": "2026-07",
      "notes": "NIMC announced that the NIMC Act 2026 designates NIMC as Root Certification Authority for Nigeria's National PKI and DPI and recognizes physical and digital identity credentials linked to NIN."
    },
    {
      "key": "ng:ndpc",
      "name": "Nigeria Data Protection Commission",
      "jurisdiction": "Nigeria",
