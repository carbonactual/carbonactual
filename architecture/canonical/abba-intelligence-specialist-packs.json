        "REQUEST_AUTHORIZATION",
        "REQUEST_CONSENT",
        "REQUEST_REVIEW",
        "ESCALATE_TO_HUMAN",
        "CAPTURE_HUMAN_DECISION",
        "VERIFY_HUMAN_DECISION_EVIDENCE",
        "RESUME_GOVERNED_CONTINUATION"
