        "PROPOSE_PRIMARY_PROVIDER",
        "PROPOSE_FALLBACK_PROVIDERS",
        "REASSESS_PROVIDER_ROUTE"
      ]
    },
    {
      "packId": "REASONING_SUBSTRATE_BINDING",
      "insertionPoint": "AFTER_REASONING_AND_RECOMMENDATION_BOUNDARY",
