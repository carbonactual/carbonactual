{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ABBA Intelligence Specialist Packs",
  "version": "1.0.0",
  "status": "canonical-derived-extension-contract",
  "principle": "Specialist packs extend the core graph without creating a second orchestration universe.",
